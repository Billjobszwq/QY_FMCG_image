# ===== RA-020 安全 Token（非 dev 环境必填）=====
# 运行环境：dev 允许免 token 本机管理；其他值（如 prod）下管理接口强制要求 admin token
APP_ENV=dev
# 识别服务管理接口（/v2/models/switch、/v2/admin/reload）的 Bearer token
RECOGNIZE_ADMIN_TOKEN=
# Label Studio webhook 签名密钥（非 dev 环境强制校验 HMAC）
LABEL_STUDIO_WEBHOOK_SECRET=
# Label Studio API key（由 bootstrap 生成，勿手工提交真实值）
LABEL_STUDIO_API_KEY=
# 识别服务 CORS 白名单（逗号分隔完整 Origin，空则不开放跨域）
RECOGNIZE_CORS_ORIGINS=

# 登录凭据（首次启动锁定，之后不可变更；格式 username:password）
PLATFORM_ADMIN_CREDENTIALS=<username>:<password>
