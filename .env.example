# Copy this file to .env and replace placeholders locally. Never commit .env.

# Local model gateway
OMLX_BASE_URL=http://127.0.0.1:8455/v1
OMLX_API_KEY=
OMLX_VLM_MODEL=<vision-language-model-id>
OMLX_EMBED_MODEL=<embedding-model-id>
OMLX_OCR_BOX_MODEL=<ocr-box-model-id>
OMLX_OCR_TEXT_MODEL=<ocr-text-model-id>
OMLX_EMBED_DIM=1024
OMLX_TIMEOUT=180

# Local-only source assets
KB_REFERENCE_DIR=<path-to-reference-data>
FIELD_XLSX=<path-to-field-metadata>
KB_DATA_DIR=.kb

# Optional object source
OSS_BASE=https://example.invalid
OSS_PREFIX=<object-prefix>/

# Optional PostgreSQL / Redis / object storage
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=
POSTGRES_DB=<database-name>
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
MINIO_ROOT_USER=<object-store-user>
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_IMAGES=<image-bucket>
MINIO_BUCKET_FIELD=<field-bucket>
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false

# Optional Label Studio integration
LABEL_STUDIO_PORT=8080
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_USERNAME=<labeling-user>
LABEL_STUDIO_PASSWORD=
LABEL_STUDIO_API_KEY=
LABEL_STUDIO_WEBHOOK_SECRET=

# Application security
APP_ENV=dev
RECOGNIZE_ADMIN_TOKEN=
RECOGNIZE_CORS_ORIGINS=
PLATFORM_ADMIN_CREDENTIALS=<username>:<password>
